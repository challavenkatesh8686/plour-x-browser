# Same Supabase project as every other PlourX app — one PlourX account across apps.
# Copy this file to .env and fill in the real values (see plour-x-ai/client/.env).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Origin of the PlourX AI server (serves uploaded profile pictures). Optional.
VITE_PLOURX_API_URL=

# PlourX AI chat assistant (optional). Origin of the deployed PlourX website API that serves /api/chat,
# e.g. https://plourx.example.com (trailing slash is trimmed). The assistant stays hidden unless this AND
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY above are set AND an admin enables it for this app under
# PlourX website > Admin > Settings.
VITE_API_BASE=

# PlourX website API: the About page Contact and Feedback forms call /api/contact and /api/feedback on it.
# If VITE_API_BASE above is empty they use https://plour-x-website.vercel.app (the chat assistant itself still needs it set).
